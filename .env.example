# Copy this file to ".env" and fill in your own values. ".env" is git-ignored and must NEVER be committed.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Standard mode. Do not use a "-contributor" model with real documents: Contributor mode lets Meta train on them.
META_MODEL_EXTRACT=muse-spark-1.3

# Optional second reader: Muse Glimmer 30B (Meta open weights, Apache 2.0), here via NVIDIA's API catalog
# (free trial key from build.nvidia.com). Leave empty to switch it off. Self-host the weights to keep documents in-house.
NVIDIA_API_KEY=
GLIMMER_MODEL=meta/muse-glimmer-30b
