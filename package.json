{
  "name": "substance-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks whether a board meeting met a jurisdiction's physical-presence rule, using evidence from the meeting pack. Information and calculation only, not legal or tax advice.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen": "tsx scripts/generate-synthetic.ts",
    "gen:test": "tsx scripts/generate-synthetic.ts test",
    "eval": "tsx scripts/eval-extraction.ts",
    "record": "tsx scripts/record-demo.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web --noEmit",
    "server": "tsx server/index.ts",
    "app": "npm run web:build && tsx server/index.ts",
    "security:http": "node security/poc-http.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "geist": "^1.8.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.45.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
