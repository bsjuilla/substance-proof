{
  "name": "substance-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks whether a board meeting met a jurisdiction's physical-presence rule, using evidence from the meeting pack. Information and calculation only, not legal or tax advice.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen": "tsx scripts/generate-synthetic.ts",
    "gen:test": "tsx scripts/generate-synthetic.ts test",
    "eval": "tsx scripts/eval-extraction.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "openai": "^7.45.1",
    "puppeteer-core": "^25.16.0",
    "zod": "^4.6.7"
  }
}
